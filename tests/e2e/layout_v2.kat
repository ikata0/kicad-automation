# Layout after the v2 sync: signal flow left to right, feedback above the amplifier,
# supply unit and decoupling to the right. Connectivity is unchanged (check --expect),
# and every net named in the design keeps a visible name (label or power symbol).

# --- placement ---
move J1 --to 88.9,99.06
move U1 --unit 1 --to 127,101.6 --mirror x
move R1 --to 127,86.36 --rot 90
move CF1 --to 127,73.66 --rot 90
move ROUT --to 157.48,101.6 --rot 90
move J2 --to 175.26,101.6 --mirror y
move U1 --unit 2 --to 127,127
move U1 --unit 3 --to 190.5,127
move C2 --to 210.82,127
move C3 --to 231.14,127

# --- PD_ANODE: photodiode -> inverting input, feedback node as wires ---
detach J1.1
detach U1.2
detach R1.1
detach CF1.1
connect J1.1 U1.2
connect R1.1 114.3,99.06 --via 114.3,86.36
connect CF1.1 114.3,86.36 --via 114.3,73.66
label PD_ANODE 101.6,99.06

# --- TIA_OUT: output node -> feedback + series resistor ---
detach U1.1
detach R1.2
detach CF1.2
detach ROUT.1
connect U1.1 ROUT.1
connect R1.2 139.7,101.6 --via 139.7,86.36
connect CF1.2 139.7,86.36 --via 139.7,73.66
label TIA_OUT 142.24,101.6

# --- OUT: series resistor -> output connector; its ground downwards ---
detach ROUT.2
detach J2.1
connect ROUT.2 J2.1
label OUT 162.56,101.6
detach J2.2
power GND J2.2 --stub -5.08,0

# --- unused stage B as a wired follower ---
detach U1.6
detach U1.7
connect U1.7 U1.6 --via 137.16,127 137.16,137.16 116.84,137.16 116.84,129.54
label U1B_FB 119.38,137.16
set U1 Value --unit 2 --at 147.32,127
